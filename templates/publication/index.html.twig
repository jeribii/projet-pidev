{% extends 'base.html.twig' %}

{% block title %}Liste des publications{% endblock %}

{% block body %}
<div class="container">
    <h1>Liste des publications</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Date</th>
                <th>Image</th>
                <th>Client</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for publication in publications %}
                <tr>
                    <td>{{ publication.titre }}</td>
                    <td>{{ publication.description }}</td>
                    <td>{{ publication.date|date('d/m/Y H:i') }}</td>
                    <td>
                        {% if publication.image %}
                            <img src="{{ publication.image }}" alt="{{ publication.titre }}" width="100">
                        {% else %}
                            Pas d'image
                        {% endif %}
                    </td>
                    <td>
                        {% if publication.client %}
                            {{ publication.client.Nom }}
                        {% else %}
                            <span style="color: red;">Client non défini</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('publication_show', {'id': publication.id}) }}" class="btn btn-secondary">Voir</a>
                        <a href="{{ path('publication_edit', {'id': publication.id}) }}" class="btn btn-warning">Modifier</a>
                        <a href="{{ path('reclamation_new', {'publicationId': publication.id}) }}" class="btn btn-primary">Faire une réclamation</a>
                        <form method="post" action="{{ path('publication_delete', {'id': publication.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette publication ?');" class="form-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ publication.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center">Aucune publication trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('publication_new') }}" class="btn btn-primary">Créer une nouvelle publication</a>
</div>
{% endblock %}
