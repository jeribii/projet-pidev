{% extends 'base.html.twig' %}

{% block title %}Détails de la publication{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center">Publication : {{ publication.titre }}</h1>

        <div class="card shadow-sm p-4">
            <p><strong>Description :</strong> {{ publication.description }}</p>
            <p><strong>Date :</strong> {{ publication.date|date('d/m/Y H:i') }}</p>

            {% if publication.image %}
                <p><strong>Image :</strong></p>
                <img src="{{ publication.image }}" alt="{{ publication.titre }}" class="img-fluid rounded shadow">
            {% else %}
                <p><strong>Image :</strong> Pas d'image</p>
            {% endif %}

            <p><strong>Client :</strong> 
                {% if publication.client %}
                    {{ publication.client.Nom }}
                {% else %}
                    <span class="text-danger">Client non défini</span>
                {% endif %}
            </p>

            <div class="mt-3">
                {% if publication.id is defined %}
                    <a href="{{ path('publication_edit', {'id': publication.id}) }}" class="btn btn-primary">Modifier</a>
                {% endif %}

                <form method="post" action="{{ path('publication_delete', {'id': publication.id}) }}" 
                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette publication ?');" 
                      class="d-inline">
                    <button type="submit" class="btn btn-danger">Supprimer</button>
                </form>

                <a href="{{ path('publication_index') }}" class="btn btn-secondary">Retour à la liste</a>
            </div>
        </div>

        <div class="mt-4">
            <h3>Ajouter un commentaire</h3>
            <div class="card p-4">
                {{ form_start(commentaire_form) }}
                    {{ form_row(commentaire_form.description) }}
                    {{ form_row(commentaire_form.image) }}
                    <button type="submit" class="btn btn-success">Ajouter Commentaire</button>
                {{ form_end(commentaire_form) }}
            </div>
        </div>

        <div class="mt-4">
            <h3>Commentaires :</h3>
            {% if commentaires is not empty %}
                <ul class="list-group">
                    {% for commentaire in commentaires %}
                        <li class="list-group-item">
                            <p><strong>Description :</strong> {{ commentaire.description }}</p>
                            {% if commentaire.image %}
                                <img src="{{ commentaire.image }}" alt="Image du commentaire" class="img-fluid rounded shadow">
                            {% endif %}
                            <div class="mt-2">
                                <a href="{{ path('commentaire_show', {'id': commentaire.id}) }}" class="btn btn-info btn-sm">Voir</a>
                                {% if commentaire.id is defined %}
                                    <a href="{{ path('commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                                {% endif %}
                                <form method="post" action="{{ path('commentaire_delete', {'id': commentaire.id}) }}" 
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');" 
                                      class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-muted">Aucun commentaire pour cette publication.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
