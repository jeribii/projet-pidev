{% extends 'base.html.twig' %}

{% block title %}Liste des réclamations{% endblock %}

{% block body %}
<div class="container">
    <h1>Liste des réclamations</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Titre</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for reclamation in reclamations %}
                <tr>
                    <td>{{ reclamation.titre }}</td>
                    <td>{{ reclamation.description }}</td>
                    <td>
                        <a href="{{ path('reclamation_show', {'id': reclamation.id}) }}" class="btn btn-secondary">Voir</a>
                        <a href="{{ path('reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-warning">Modifier</a>
                        <form method="post" action="{{ path('reclamation_delete', {'id': reclamation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?');" class="form-inline d-inline">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3" class="text-center">Aucune réclamation trouvée.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3>Faire une réclamation</h3>
    {% for publication in publications %}
        <a href="{{ path('reclamation_new', {'publicationId': publication.id}) }}" class="btn btn-primary" style="margin-right: 10px;">Faire une réclamation pour "{{ publication.titre }}"</a><br>
    {% else %}
        <p>Aucune publication trouvée pour faire une réclamation.</p>
    {% endfor %}
</div>
{% endblock %}
