{% extends 'base.html.twig' %}

{% block title %}Liste des Commentaires{% endblock %}

{% block body %}
<div class="container">
    <h1>Liste des Commentaires</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Description</th>
                <th>Image</th>
                <th>Publication</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for commentaire in commentaires %}
                <tr>
                    <td>{{ commentaire.description }}</td>
                    <td>
                        {% if commentaire.image %}
                            <img src="{{ commentaire.image }}" alt="Commentaire Image" width="100">
                        {% else %}
                            Pas d'image
                        {% endif %}
                    </td>
                    <td>
                        {% if commentaire.publication %}
                            {{ commentaire.publication.titre }}
                        {% else %}
                            <span style="color: red;">Aucune publication associée</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('commentaire_show', {'id': commentaire.id}) }}" class="btn btn-secondary">Voir</a>
                        <a href="{{ path('commentaire_edit', {'id': commentaire.id}) }}" class="btn btn-warning">Modifier</a>
                        <form method="post" action="{{ path('commentaire_delete', {'id': commentaire.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');" class="form-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
                            <button type="submit" class="btn btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center">Aucun commentaire trouvé.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    <a href="{{ path('commentaire_new') }}" class="btn btn-primary">Créer un nouveau commentaire</a>
</div>
{% endblock %}
